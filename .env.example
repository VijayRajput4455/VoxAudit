APP_NAME=VoxAudit
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/voxaudit

LOG_LEVEL=INFO
LOG_FORMAT=json

EMBEDDING_DEVICE=auto
EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
EMBEDDING_DIMENSION=192
MIN_EMBEDDING_AUDIO_SECONDS=1.0
MAX_EMBEDDING_AUDIO_SECONDS=300.0