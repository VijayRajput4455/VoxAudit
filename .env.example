APP_NAME=VoxAudit
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/voxaudit

LOG_LEVEL=INFO
LOG_FORMAT=json

EMBEDDING_DEVICE=auto
EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
EMBEDDING_DIMENSION=192
MIN_EMBEDDING_AUDIO_SECONDS=1.0
MAX_EMBEDDING_AUDIO_SECONDS=300.0

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=voxaudit
RABBITMQ_PASSWORD=voxaudit_password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=voice_enrollment_jobs
RABBITMQ_EXCHANGE=voxaudit_events
RABBITMQ_ROUTING_KEY=voice.enrollment

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=voxaudit
MINIO_SECRET_KEY=voxaudit_password
MINIO_SECURE=false
MINIO_BUCKET=voice-samples

VOICE_ENROLLMENT_MAX_RETRIES=3

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=300.0
