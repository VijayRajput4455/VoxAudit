          "rawQuery": true,
          "rawSql": "SELECT to_char(c.created_at, 'YYYY-MM-DD HH24:MI:SS') AS \"Processed At\", coalesce(c.audit_code, c.code, substring(c.id::text, 1, 8)) AS \"Call Reference\", coalesce(e.first_name || ' ' || e.last_name, 'Unassigned') AS \"Agent Name\", coalesce(round(c.duration_seconds::numeric, 0), 0) || 's' AS \"Audio Duration\", c.qa_score AS \"QA Score\", coalesce(c.qa_scorecard_json->'overall_evaluation'->>'grade', '-') AS \"Grade\", coalesce(c.qa_scorecard_json->'customer_experience'->'sentiment'->>'final', '-') AS \"Sentiment\", coalesce(c.qa_scorecard_json->'customer_experience'->'issue_resolution'->>'status', '-') AS \"Issue Resolution\" FROM call_jobs c LEFT JOIN employees e ON c.identified_employee_id = e.id LEFT JOIN departments d ON e.department_id = d.id WHERE ('$department' = 'All' OR coalesce(d.name, 'Unassigned') = '$department') AND ('$employee' = 'All' OR coalesce(e.first_name || ' ' || e.last_name, 'Unassigned') = '$employee') AND ('$grade' = 'All' OR coalesce(c.qa_scorecard_json->'overall_evaluation'->>'grade', '-') = '$grade') ORDER BY c.created_at DESC LIMIT 50;",
