          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(c.id) AS \"Total Audited\" FROM call_jobs c LEFT JOIN employees e ON c.identified_employee_id = e.id LEFT JOIN departments d ON e.department_id = d.id WHERE c.status = 'COMPLETED' AND ('$department' = 'All' OR coalesce(d.name, 'Unassigned') = '$department') AND ('$employee' = 'All' OR coalesce(e.first_name || ' ' || e.last_name, 'Unassigned') = '$employee') AND ('$grade' = 'All' OR coalesce(c.qa_scorecard_json->'overall_evaluation'->>'grade', '-') = '$grade');",
          "refId": "A"
        }
      ],
      "title": "Total Calls Audited",
      "type": "stat"
